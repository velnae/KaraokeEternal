NODE_ENV=production
KES_HOST=127.0.0.1
KES_PORT=3010
KES_URL_PATH=/
KES_PATH_DATA=/var/www/vhosts/karaoke.puyu.pe/karaoke-data
KES_FFMPEG_PATH=/usr/bin/ffmpeg
KES_FFPROBE_PATH=/usr/bin/ffprobe
KES_ROTATE_KEY=false

# Supply private keys on the server, never in Git.
KES_YOUTUBE_API_KEY=
KES_YOUTUBE_REGION=PE
KES_YOUTUBE_MAX_RESULTS=10
KES_ELEVENLABS_API_KEY=
KES_GEMINI_API_KEY=
