# Copy this file to .env and fill in the keys for the services you use.
# Development-only player controls. Restart npm run dev after changing this flag.
# Ignored in production, even when true.
DEV_PLAYER_TOOLS=false

# Optional data directory. Empty uses the application's default directory.
KES_PATH_DATA=

# YouTube Data API v3.
# Leave the key empty to disable YouTube search.
KES_YOUTUBE_API_KEY=
KES_YOUTUBE_REGION=PE
KES_YOUTUBE_MAX_RESULTS=10
KES_ELEVENLABS_API_KEY=
# Gemini is used only for greeting speech. Enable it in Animator > Voz de saludos.
KES_GEMINI_API_KEY=
# Optional generic Gemini key for local tooling; greeting speech uses KES_GEMINI_API_KEY.
GEMINI_API_KEY=
