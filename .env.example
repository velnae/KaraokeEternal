# Copy this file to .env and set your YouTube Data API v3 key.
# Leave the key empty to disable YouTube search.
KES_YOUTUBE_API_KEY=
KES_YOUTUBE_REGION=PE
KES_YOUTUBE_MAX_RESULTS=10
KES_ELEVENLABS_API_KEY=
# Gemini is used only for greeting speech. Enable it in Animator > Voz de saludos.
KES_GEMINI_API_KEY=
